BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Shared secret proving a request came through the authenticated Next.js proxy
# at app/api/backend/[...path]. Must match the backend's BACKEND_PROXY_SECRET.
# Both sides fail closed when it is unset: the proxy returns 503 and the API
# refuses every guarded route.
BACKEND_PROXY_SECRET=dev-only-change-me

# Clerk (get from clerk.com dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/create
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/create
